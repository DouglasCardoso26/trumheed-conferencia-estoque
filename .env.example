# Copie para .env (ou defina no PowerShell) e ajuste. Nunca coloque valores reais no repositorio.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-secreta
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Somente em producao (Render):
# DATABASE_URL=postgres://usuario:senha@host:5432/banco
# DJANGO_FORCE_HTTPS=1
# DJANGO_SUPERUSER_USERNAME=...
# DJANGO_SUPERUSER_EMAIL=...
# DJANGO_SUPERUSER_PASSWORD=...
